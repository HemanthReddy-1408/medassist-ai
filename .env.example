# OpenAI-compatible provider (Groq by default).
MEDASSIST_API_KEY=
MEDASSIST_BASE_URL=https://api.groq.com/openai/v1

# The agent under test and the judge that grades it MUST differ.
# A model grading its own output is a self-assessment, not an evaluation.
MEDASSIST_SUBJECT_MODEL=openai/gpt-oss-20b
MEDASSIST_JUDGE_MODEL=openai/gpt-oss-120b

# Optional. NCBI raises the E-utilities rate limit from 3/s to 10/s with a key.
NCBI_API_KEY=
# Sent as a User-Agent to public APIs; courteous and sometimes required.
MEDASSIST_CONTACT_EMAIL=
